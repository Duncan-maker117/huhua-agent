{#- 六款模板共用的小片段。不是可选模板（不在 renderer.TEMPLATES 里）。 -#}

{#- 页眉第二行：联系方式与可选个人信息，用 · 分隔；空值不渲染。 -#}
{% macro contact_line(b) -%}
{%- set labels = {'phone': '', 'email': '', 'location': '', 'gender': '', 'age': '年龄 ', 'birthday': '出生 ', 'ethnicity': '', 'hometown': '籍贯 ', 'political': '', 'height': '身高 ', 'availability': '可实习时间：'} -%}
{%- set ns = namespace(n=0) -%}
{%- for key, label in labels.items() -%}
  {%- if b.get(key) -%}
    {%- if ns.n %}<span class="sep"> · </span>{% endif -%}
    <span class="contact-token">{{ label }}<span data-field-path="/basic_info/{{ key }}">{{ b.get(key) }}</span></span>
    {%- set ns.n = ns.n + 1 -%}
  {%- endif -%}
{%- endfor -%}
{%- for link in b.get('links', []) -%}
  {%- if ns.n %}<span class="sep"> · </span>{% endif -%}
  <span class="contact-token"><span data-field-path="/basic_info/links/{{ loop.index0 }}/text">{{ link.text }}</span>：<span data-field-path="/basic_info/links/{{ loop.index0 }}/url">{% if link.url | safe_link_url %}<a href="{{ link.url | safe_link_url }}" title="{{ link.url }}" rel="noopener noreferrer">{{ link.url | link_label }}</a>{% else %}{{ link.url }}{% endif %}</span></span>
  {%- set ns.n = ns.n + 1 -%}
{%- endfor -%}
{%- endmacro %}

{#- 页眉第一行：姓名 + 求职意向。 -#}
{% macro name_line(b) -%}
<span class="h-name" data-field-path="/basic_info/name">{{ b.name }}</span>{% if b.objective %}<span class="h-obj">求职意向：<span data-field-path="/basic_info/objective">{{ b.objective }}</span></span>{% endif %}
{%- endmacro %}

{% macro positioning_line(text) -%}
{%- if text %}<div class="positioning-title">个人定位</div><div class="positioning" data-field-path="/summary">{{ text }}</div>{% endif -%}
{%- endmacro %}

{% macro density_styles() -%}
:root { {% for name, value in layout_css.items() %}--{{ name }}: {{ value }}; {% endfor %} }
{%- endmacro %}

{% macro layout_styles() -%}
.positioning { font-size: var(--summary-font-size); line-height: var(--summary-line-height); margin-top: 3px; }
.positioning-title { font-size: var(--summary-font-size); font-weight: 700; break-after: avoid; }
.section, .item { break-inside: auto; page-break-inside: auto; }
.section-title { break-after: avoid; page-break-after: avoid; }
.awards-compact { line-height: var(--summary-line-height); break-inside: auto; orphans: 1; widows: 1; }
.award-details { margin-top: 4px; }
.contact { line-height: 1.4; }
.contact-token, .contact-link { display: inline-block; white-space: nowrap; overflow-wrap: normal; word-break: normal; }
.contact a, .contact-links a { white-space: nowrap; overflow-wrap: normal; word-break: normal; }
.contribution-link { white-space: nowrap; font-weight: 400; }
{%- endmacro %}

{#- 照片只有上传了才渲染（data URL 已由 renderer 校验）。 -#}
{% macro photo_box(b) -%}
{%- if b.photo %}<div class="photo"><img src="{{ b.photo }}" style="width:100%;height:100%;object-fit:cover;border-radius:3px;"></div>{% endif -%}
{%- endmacro %}

{% macro date_range(item, section, index) -%}
{%- if item.start_date or item.end_date -%}
<span class="item-date">{% if item.start_date %}<span data-field-path="/{{ section }}/{{ index }}/start_date">{{ item.start_date }}</span>{% endif %}{% if item.start_date and item.end_date %}—{% endif %}{% if item.end_date %}<span data-field-path="/{{ section }}/{{ index }}/end_date">{{ item.end_date }}</span>{% endif %}</span>
{%- endif -%}
{%- endmacro %}

{#- 项目标题行：名称 ｜ 可选定位 ｜ 性质（旧稿仍显示角色）；日期靠右，沿用原视觉。 -#}
{% macro project_head(p, index) -%}
<div class="item-header project-head">
  <span class="item-title"><span data-field-path="/projects/{{ index }}/name">{{ p.name }}</span>{% if p.positioning %} ｜ <span data-field-path="/projects/{{ index }}/positioning">{{ p.positioning }}</span>{% endif %}{% if p.project_type %} ｜ <span data-field-path="/projects/{{ index }}/project_type">{{ p.project_type }}</span>{% elif p.role %} ｜ <span class="item-role" data-field-path="/projects/{{ index }}/role">{{ p.role }}</span>{% endif %}</span>
  {{ date_range(p, 'projects', index) }}
</div>
{%- endmacro %}

{#- 技能：短分组合行，保留原分组及技能编辑路径。 -#}
{% macro skill_rows(groups) -%}
{% for row in groups | display_skill_rows %}<div class="skill-row">{% for group_name, items in row %}{% if not loop.first %}；{% endif %}<strong><span data-field-path="/skill_groups/{{ group_name | pointer_escape }}" data-field-kind="group-name">{{ group_name }}</span>：</strong>{% for skill in items %}<span data-field-path="/skill_groups/{{ group_name | pointer_escape }}/{{ loop.index0 }}">{{ skill }}</span>{% if not loop.last %} / {% endif %}{% endfor %}{% endfor %}</div>{% endfor %}
{%- endmacro %}

{% macro contribution_sections(section) -%}
{% set kind = section.kind %}
{% if kind == 'awards' %}
<p class="item awards-compact">{% for item in awards %}{% set index = item._source_index %}<span data-field-path="/awards/{{ index }}/name">{{ item.name }}</span>{% if item.level %} <span data-field-path="/awards/{{ index }}/level">{{ item.level }}</span>{% endif %}{% if item.date %} <span data-field-path="/awards/{{ index }}/date">{{ item.date }}</span>{% endif %}{% if not loop.last %}；{% endif %}{% endfor %}</p>
{% for item in awards %}{% set index = item._source_index %}
{% if item._display_bullets or item.links %}<div class="item award-details">
{% if item._display_bullets %}<ul>{% for bullet_index, bullet in item._display_bullets %}<li>{% if awards | length > 1 %}<span class="item-title">{{ item.name }}：</span>{% endif %}<span data-field-path="/awards/{{ index }}/bullets/{{ bullet_index }}">{{ bullet }}</span></li>{% endfor %}</ul>{% endif %}
{% for link in item.links | default([]) %}<div class="item-sub"><span data-field-path="/awards/{{ index }}/links/{{ loop.index0 }}/text">{{ link.text }}</span>：<span data-field-path="/awards/{{ index }}/links/{{ loop.index0 }}/url">{% if link.url | safe_link_url %}<a href="{{ link.url | safe_link_url }}" title="{{ link.url }}" rel="noopener noreferrer">{{ link.url | link_label }}</a>{% else %}{{ link.url }}{% endif %}</span></div>{% endfor %}
</div>{% endif %}
{% endfor %}
{% else %}
{% for item in open_source %}
{% set index = item._source_index %}
<div class="item">
  <div class="item-header">
    <span class="item-title">{{ contribution_title(item, index) }}</span>
    {{ date_range(item, kind, index) }}
  </div>
  {% if item._display_bullets %}<ul>{% for bullet_index, bullet in item._display_bullets %}<li><span data-field-path="/{{ kind }}/{{ index }}/bullets/{{ bullet_index }}">{{ bullet }}</span></li>{% endfor %}</ul>{% endif %}
</div>
{% endfor %}
{% endif %}
{%- endmacro %}

{% macro contribution_title(item, index) -%}
{%- set first = (item.links | default([]) | first) -%}
{%- if first and first.url | safe_link_url %}<a href="{{ first.url | safe_link_url }}" rel="noopener noreferrer">{% endif -%}
<span data-field-path="/open_source/{{ index }}/name">{{ item.name }}</span>{% if item.summary %}（<span data-field-path="/open_source/{{ index }}/summary">{{ item.summary }}</span>）{% endif %}{% if item.pr %}｜ <span data-field-path="/open_source/{{ index }}/pr">{{ item.pr }}</span>{% endif %}
{%- if first and first.url | safe_link_url %}</a>{% endif -%}
{%- for link in item.links | default([]) %}<span class="contribution-link"> · <span data-field-path="/open_source/{{ index }}/links/{{ loop.index0 }}/text">{% if not loop.first or not item.pr %}{{ link.text }}{% endif %}</span><span data-field-path="/open_source/{{ index }}/links/{{ loop.index0 }}/url">{% if link.url | safe_link_url %}<a href="{{ link.url | safe_link_url }}" title="{{ link.url }}" rel="noopener noreferrer">{% if loop.first %}链接{% else %}{{ link.url | link_label }}{% endif %}</a>{% else %}{{ link.url }}{% endif %}</span></span>{% endfor -%}
{%- endmacro %}

{% macro campus_section() -%}
{% for item in campus %}{% set index = item._source_index %}
<div class="item">
  <div class="item-header project-head">
    <span class="item-title"><span data-field-path="/campus/{{ index }}/name">{{ item.name }}</span>{% if item.role %} ｜ <span class="item-role" data-field-path="/campus/{{ index }}/role">{{ item.role }}</span>{% endif %}</span>
    {{ date_range(item, 'campus', index) }}
  </div>
  {% if item._display_bullets %}<ul>{% for bullet_index, bullet in item._display_bullets %}<li><span data-field-path="/campus/{{ index }}/bullets/{{ bullet_index }}">{{ bullet }}</span></li>{% endfor %}</ul>{% endif %}
  {% for link in item.links | default([]) %}<div class="item-sub"><span data-field-path="/campus/{{ index }}/links/{{ loop.index0 }}/text">{{ link.text }}</span>：<span data-field-path="/campus/{{ index }}/links/{{ loop.index0 }}/url">{% if link.url | safe_link_url %}<a href="{{ link.url | safe_link_url }}" rel="noopener noreferrer">{{ link.url | link_label }}</a>{% else %}{{ link.url }}{% endif %}</span></div>{% endfor %}
</div>
{% endfor %}
{%- endmacro %}
