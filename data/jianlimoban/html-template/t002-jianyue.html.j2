{% import '_macros.html.j2' as m with context -%}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>{{ basic_info.name }} · 个人简历</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    width: 210mm; min-height: 297mm;
    font-family: 'PingFang SC', 'Noto Sans SC', -apple-system, sans-serif;
    color: #2b2b2b;
    background: #fff;
    font-size: 10pt;
    line-height: 1.65;
  }
  .header {
    background: #3a4a5c;
    padding: 20px 28px;
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .body {
    padding: 0 28px 24px;
  }
  .section {
    margin-top: 16px;
  }
  .section-title {
    display: flex; align-items: center; gap: 0;
    background: #eef2f6;
    border-left: 4px solid #3a6a9c;
    padding: 5px 14px;
    font-size: 11pt; font-weight: 600;
    color: #1a2a3a;
    margin-bottom: 10px;
  }
  .info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 32px;
    row-gap: 5px;
    padding: 0 6px;
  }
  .info-item { font-size: 9.5pt; color: #333; }
  .info-item .lbl { color: #666; min-width: 52px; display: inline-block; }
  .info-item .lbl::after { content: '：'; }
  .item { padding: 0 6px; margin-bottom: 12px; }
  .item-header {
    display: flex; justify-content: space-between; align-items: baseline;
    margin-bottom: 3px;
  }
  .item-title { font-weight: 600; font-size: 10pt; color: #1a2a3a; }
  .item-sub { font-size: 9pt; color: #3a6a9c; margin-bottom: 3px; }
  .item-date { font-size: 9pt; color: #6a8aaa; }
  ul { margin-left: 18px; }
  li { font-size: 9.5pt; color: #333; margin-bottom: 3px; }
  .desc { font-size: 9.5pt; color: #333; padding: 0 6px; }

  /* 页眉：姓名 + 求职意向一行，联系方式一行；无照片不占位 */
  .header-text { flex: 1; min-width: 0; }
  .h-name { font-weight: 600; }
  .h-obj { margin-left: 14px; }
  .contact .sep { opacity: .55; }
  .photo { width: 72px; height: 92px; flex: none; border-radius: 3px; overflow: hidden; }
  .item-header.project-head { white-space: nowrap; }
  .item-role { font-weight: 400; }
  .skill-row { margin-bottom: 3px; }
  .header { padding: 14px 28px; gap: 18px; }
  .h-name { font-size: 20pt; letter-spacing: 3px; color: #fff; }
  .h-obj { font-size: 10.5pt; color: #a0b8d0; }
  .contact { font-size: 9.5pt; color: #c8d8e8; margin-top: 2px; }
  .photo { border: 2px solid #5a7a99; }
  {{ m.layout_styles() }}
</style>
</head>
<body>
  <div class="header">
    <div class="header-text">
      <div class="h-line">{{ m.name_line(basic_info) }}</div>
      <div class="contact">{{ m.contact_line(basic_info) }}</div>
      {{ m.positioning_line(summary) }}
    </div>
    {{ m.photo_box(basic_info) }}
  </div>

  <div class="body">
    {% for section in resume_sections %}
{% if (section.kind == 'custom' and (section.title or section.content)) or (section.kind == 'education' and education) or (section.kind == 'work_experience' and work_experience) or (section.kind == 'projects' and projects) or (section.kind == 'open_source' and open_source) or (section.kind == 'awards' and awards) or (section.kind == 'skills' and (has_grouped_skills or skills)) or (section.kind == 'certificates' and certificates) or (section.kind == 'self_evaluation' and self_evaluation) %}
  <div class="section">
  {% if section.title %}
  <div class="section-title"><span{% if section.title_path %} data-field-path="{{ section.title_path }}"{% endif %}>{{ section.title }}</span></div>
  {% endif %}
  {% if section.kind == 'education' %}
      {% for edu in education %}{% set edu_index = edu._source_index %}
      <div class="item">
        <div class="item-header">
          <span class="item-title"><span data-field-path="/education/{{ edu_index }}/school">{{ edu.school }}</span>　<span data-field-path="/education/{{ edu_index }}/major">{{ edu.major }}</span>{% if edu.degree %}（<span data-field-path="/education/{{ edu_index }}/degree">{{ edu.degree }}</span>）{% endif %}</span>
          {% if edu.start_date or edu.end_date %}<span class="item-date">{% if edu.start_date %}<span data-field-path="/education/{{ edu_index }}/start_date">{{ edu.start_date }}</span>{% endif %}{% if edu.start_date and edu.end_date %}—{% endif %}{% if edu.end_date %}<span data-field-path="/education/{{ edu_index }}/end_date">{{ edu.end_date }}</span>{% endif %}</span>{% endif %}
        </div>
        {% if edu.highlights %}
        <div class="item-sub">主修课程</div>
        <ul>
          <li><span data-field-path="/education/{{ edu_index }}/highlights">{{ edu.highlights }}</span></li>
        </ul>
        {% endif %}
      </div>
      {% endfor %}

  {% elif section.kind == 'work_experience' %}
      {% for job in work_experience %}{% set job_index = job._source_index %}
      <div class="item">
        <div class="item-header">
          <span class="item-title"><span data-field-path="/work_experience/{{ job_index }}/company">{{ job.company }}</span></span>
          {% if job.start_date or job.end_date %}<span class="item-date">{% if job.start_date %}<span data-field-path="/work_experience/{{ job_index }}/start_date">{{ job.start_date }}</span>{% endif %}{% if job.start_date and job.end_date %}—{% endif %}{% if job.end_date %}<span data-field-path="/work_experience/{{ job_index }}/end_date">{{ job.end_date }}</span>{% endif %}</span>{% endif %}
        </div>
        {% if job.title %}<div class="item-sub"><span data-field-path="/work_experience/{{ job_index }}/title">{{ job.title }}</span></div>{% endif %}
        {% if job.bullets %}
        <ul>
          {% for b in job.bullets %}<li><span data-field-path="/work_experience/{{ job_index }}/bullets/{{ loop.index0 }}">{{ b }}</span></li>{% endfor %}
        </ul>
        {% endif %}
      </div>
      {% endfor %}

  {% elif section.kind == 'projects' %}
      {% for p in projects %}{% set p_index = p._source_index %}
      <div class="item">
        {{ m.project_head(p, p_index) }}
        {% if p.polished_bullets %}
        <ul>{% for b in p.polished_bullets %}<li><span data-field-path="/projects/{{ p_index }}/polished_bullets/{{ loop.index0 }}">{{ b }}</span></li>{% endfor %}</ul>
        {% elif p.description %}
        <ul><li><span data-field-path="/projects/{{ p_index }}/description">{{ p.description }}</span></li></ul>
        {% endif %}
      </div>
      {% endfor %}

  {% elif section.kind in ['open_source', 'awards'] %}
  {{ m.contribution_sections(section) }}
  {% elif section.kind == 'skills' %}
{% if has_grouped_skills %}
      <div>
        {{ m.skill_rows(skill_groups) }}
      </div>
    {% elif skills %}
      <div class="info-grid">
        {% for s in skills %}<div class="info-item"><span data-field-path="/skills/{{ loop.index0 }}">{{ s }}</span></div>{% endfor %}
      </div>
    {% endif %}
  {% elif section.kind == 'certificates' %}
  <div class="item"><ul>{% for certificate in certificates %}<li><span data-field-path="/certificates/{{ loop.index0 }}">{{ certificate }}</span></li>{% endfor %}</ul></div>
  {% elif section.kind == 'self_evaluation' %}
      <p class="desc"><span data-field-path="/self_evaluation">{{ self_evaluation }}</span></p>

  {% elif section.kind == 'custom' %}
  {% if section.content %}
  <p class="desc" style="white-space:pre-line;"><span{% if section.content_path %} data-field-path="{{ section.content_path }}"{% endif %}>{{ section.content }}</span></p>
  {% endif %}
  {% endif %}
  </div>
{% endif %}
{% endfor %}
  </div>
</body>
</html>
