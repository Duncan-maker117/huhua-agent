{% import '_macros.html.j2' as m with context -%}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>{{ basic_info.name }} · 个人简历</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    width: 210mm; min-height: 297mm;
    padding: 12mm 16mm;
    font-family: 'PingFang SC', 'Noto Sans SC', -apple-system, sans-serif;
    color: #2b2b2b;
    background: #fff;
    font-size: 10pt;
    line-height: 1.7;
  }
  .header {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 18px;
  }
  .divider { height: 1px; background: linear-gradient(90deg, #b8d8d8 0%, transparent 100%); margin-bottom: 14px; }

  .section-title {
    background: #d4e8e8;
    color: #2d6a6a;
    padding: 4px 28px 4px 16px;
    font-size: 11pt; font-weight: 600;
    margin: 12px 0 8px;
    clip-path: polygon(0 0, 100% 0, 92% 100%, 0 100%);
    width: fit-content;
    min-width: 110px;
    transform: skewX(-4deg);
  }
  .section-title span { display: inline-block; transform: skewX(4deg); }


  .item { padding: 0 8px; margin-bottom: 10px; }
  .item-text { font-size: 10pt; color: #333; }
  ul { margin-left: 18px; }
  li { font-size: 9.5pt; margin-bottom: 3px; color: #333; }
  .desc { font-size: 9.5pt; color: #333; padding: 0 8px; }

  /* 页眉：姓名 + 求职意向一行，联系方式一行；无照片不占位 */
  .header-text { flex: 1; min-width: 0; }
  .h-name { font-weight: 600; }
  .h-obj { margin-left: 14px; }
  .contact .sep { opacity: .55; }
  .photo { width: 72px; height: 92px; flex: none; border-radius: 3px; overflow: hidden; }
  .item-header.project-head { white-space: nowrap; }
  .item-role { font-weight: 400; }
  .skill-row { margin-bottom: 3px; }
  .header { align-items: center; gap: 16px; margin-bottom: 6px; }
  .h-name { font-size: 21pt; letter-spacing: 3px; color: #2d6a6a; }
  .h-obj { font-size: 11pt; color: #444; }
  .contact { font-size: 9.5pt; color: #555; margin-top: 2px; }
  .item-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 3px; }
  .item-title { font-weight: 600; color: #1a1a1a; }
  .item-date { color: #2d6a6a; font-size: 9.5pt; }
  {{ m.layout_styles() }}
</style>
</head>
<body>
  <div class="header">
    <div class="header-text">
      <div class="h-line">{{ m.name_line(basic_info) }}</div>
      <div class="contact">{{ m.contact_line(basic_info) }}</div>
      {{ m.positioning_line(summary) }}
    </div>
    {{ m.photo_box(basic_info) }}
  </div>

  {% for section in resume_sections %}
{% if (section.kind == 'custom' and (section.title or section.content)) or (section.kind == 'education' and education) or (section.kind == 'work_experience' and work_experience) or (section.kind == 'projects' and projects) or (section.kind == 'open_source' and open_source) or (section.kind == 'awards' and awards) or (section.kind == 'skills' and (has_grouped_skills or skills)) or (section.kind == 'certificates' and certificates) or (section.kind == 'self_evaluation' and self_evaluation) %}
  {% if section.title %}
  <div class="section-title"><span{% if section.title_path %} data-field-path="{{ section.title_path }}"{% endif %}>{{ section.title }}</span></div>
  {% endif %}
  {% if section.kind == 'education' %}
  <div class="item">
    {% for edu in education %}{% set edu_index = edu._source_index %}
    <p class="item-text">{% if edu.start_date or edu.end_date %}{% if edu.start_date %}<span data-field-path="/education/{{ edu_index }}/start_date">{{ edu.start_date }}</span>{% endif %}{% if edu.start_date and edu.end_date %}—{% endif %}{% if edu.end_date %}<span data-field-path="/education/{{ edu_index }}/end_date">{{ edu.end_date }}</span>{% endif %}　{% endif %}就读于<span data-field-path="/education/{{ edu_index }}/school">{{ edu.school }}</span>{% if edu.major %}<span data-field-path="/education/{{ edu_index }}/major">{{ edu.major }}</span>专业{% endif %}{% if edu.degree %}（<span data-field-path="/education/{{ edu_index }}/degree">{{ edu.degree }}</span>）{% endif %}。{% if edu.highlights %}<span data-field-path="/education/{{ edu_index }}/highlights">{{ edu.highlights }}</span>{% endif %}</p>
    {% endfor %}
  </div>

  {% elif section.kind == 'work_experience' %}
  {% for job in work_experience %}{% set job_index = job._source_index %}
  <div class="item">
    <ul>
      {% if job.start_date or job.end_date %}<li>实习时间：{% if job.start_date %}<span data-field-path="/work_experience/{{ job_index }}/start_date">{{ job.start_date }}</span>{% endif %}{% if job.start_date and job.end_date %}—{% endif %}{% if job.end_date %}<span data-field-path="/work_experience/{{ job_index }}/end_date">{{ job.end_date }}</span>{% endif %}。</li>{% endif %}
      <li>单位：<span data-field-path="/work_experience/{{ job_index }}/company">{{ job.company }}</span>。</li>
      <li>职务：<span data-field-path="/work_experience/{{ job_index }}/title">{{ job.title }}</span>。</li>
      {% if job.bullets %}
      {% for b in job.bullets %}<li><span data-field-path="/work_experience/{{ job_index }}/bullets/{{ loop.index0 }}">{{ b }}</span></li>{% endfor %}
      {% endif %}
    </ul>
  </div>
  {% endfor %}

  {% elif section.kind == 'projects' %}
  {% for p in projects %}{% set p_index = p._source_index %}
  <div class="item">
    {{ m.project_head(p, p_index) }}
    {% if p.polished_bullets %}
    <ul>{% for b in p.polished_bullets %}<li><span data-field-path="/projects/{{ p_index }}/polished_bullets/{{ loop.index0 }}">{{ b }}</span></li>{% endfor %}</ul>
    {% elif p.description %}<p class="item-text"><span data-field-path="/projects/{{ p_index }}/description">{{ p.description }}</span></p>{% endif %}
  </div>
  {% endfor %}

  {% elif section.kind in ['open_source', 'awards'] %}
  {{ m.contribution_sections(section) }}
  {% elif section.kind == 'skills' %}
{% if has_grouped_skills %}
  <div class="item">
    {{ m.skill_rows(skill_groups) }}
  </div>
  {% elif skills %}
  <div class="item">
    <ul>
      {% for s in skills %}<li><span data-field-path="/skills/{{ loop.index0 }}">{{ s }}</span></li>{% endfor %}
    </ul>
  </div>
  {% endif %}
  {% elif section.kind == 'certificates' %}
  <div class="item"><ul>{% for certificate in certificates %}<li><span data-field-path="/certificates/{{ loop.index0 }}">{{ certificate }}</span></li>{% endfor %}</ul></div>
  {% elif section.kind == 'self_evaluation' %}
  <p class="desc"><span data-field-path="/self_evaluation">{{ self_evaluation }}</span></p>

  {% elif section.kind == 'custom' %}
  {% if section.content %}
  <p class="desc" style="white-space:pre-line;"><span{% if section.content_path %} data-field-path="{{ section.content_path }}"{% endif %}>{{ section.content }}</span></p>
  {% endif %}
  {% endif %}
{% endif %}
{% endfor %}
</body>
</html>
