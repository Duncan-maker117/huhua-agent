# 默认与 Settings 一致：OpenAI SDK 默认端点；其他服务商见下方显式示例。
LLM_PROVIDER=openai
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# 不设置 LLM_BASE_URL 时使用 SDK 默认端点。
# LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# 内部提取、JD 解码与编辑模型；留空沿用 LLM_MODEL。
LLM_STRUCTURED_MODEL=

# 图片文字识别；留空时根据 API 地址自动选择 DeepSeek Flash / Qwen VL / OpenAI 视觉模型。
LLM_VISION_MODEL=

# 主对话默认保持 0.7；旧 LLM_TEMPERATURE 仍作为兼容别名，新键优先。
LLM_CHAT_TEMPERATURE=0.7
# 为后续 writer 节点预留；当前 editor 的温度不受此项影响。
LLM_WRITER_TEMPERATURE=0.4
# 默认不设置，保留服务商默认输出上限；需要显式限制时填正整数。
# LLM_MAX_TOKENS=8192

# 使用 DashScope 时，显式改为以下配置（模型名以所用服务支持的值为准）：
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen3.6-plus
# LLM_STRUCTURED_MODEL=qwen-plus

# 可选：用户主动查公司/岗位时调用 Tavily；仅传公开公司名/岗位名。
# 留空则关闭搜索入口；直接读取公开招聘链接不需要此 key。
TAVILY_API_KEY=

# RAG
CHROMA_DIR=./data/chroma_db
RAG_TOP_K=5
ENABLE_RAG=false

# 使用 DeepSeek 时，将上面的模型配置改为：
# LLM_PROVIDER=deepseek
# LLM_API_KEY=<在本地填写新生成的密钥，不要提交或贴到聊天里>
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
# LLM_STRUCTURED_MODEL=deepseek-flash
# LLM_VISION_MODEL=deepseek-flash

# SQLite
DATABASE_URL=sqlite:///./data/huhua.db
CHECKPOINT_DB_PATH=./data/checkpoints.sqlite3
# 0: keep history until explicitly deleted; positive values enable expiry.
SESSION_RETENTION_DAYS=0

# 账号与私有数据：没有有效密钥时拒绝启动，不自动读取旧明文库。
# 生成/保管说明见 docs/development/security-operations.md。
APP_ENV=local
REQUIRE_ACCOUNT=true
# 未登录可体验聊天、编辑和模板；导出、长期历史与档案仍需账号。
ALLOW_GUEST_EXPERIENCE=true
GUEST_RETENTION_HOURS=24
GUEST_DAILY_TURN_LIMIT=20
ALLOW_INSECURE_LOCAL_STORAGE=false
DATA_ENCRYPTION_KEYS={}
DATA_ENCRYPTION_ACTIVE_KEY=
ACCOUNT_SECRET=
# 本机 HTTP 调试才用 false；公开环境必须 HTTPS + true。
AUTH_COOKIE_SECURE=false
APP_ORIGIN=http://127.0.0.1:8765

# 邮箱验证码：未配置时显示登录不可用，不返回开发验证码。
EMAIL_PROVIDER=smtp
# Resend HTTPS（本机 SMTP 网络不可用时推荐）：EMAIL_PROVIDER=resend。
# 只填下面两个字段即可；不会读取 SMTP 密钥，不会自动切换或重试发送。
RESEND_API_KEY=
RESEND_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Resend SMTP: host=smtp.resend.com, port=587, username=resend.
# SMTP_PASSWORD 填服务端发送权限 API key；SMTP_FROM 使用已验证域名的发件地址。
# 没有验证域名时，Resend 测试发件地址仅能向账号自己的注册邮箱发信。
# 所有收件人的发送尝试共用额度；按 UTC 日/月重置，失败也计数，0/负数拒绝启动。
# 保守留在免费额度内；如换服务商，按其实际额度调低，不自动启用付费。
AUTH_EMAIL_DAILY_LIMIT=90
AUTH_EMAIL_MONTHLY_LIMIT=2800

# 此配额计生成/核对/归档操作次数，不是精确 token 或金额预算。
ACCOUNT_DAILY_TURN_LIMIT=80
MODEL_MAX_CONCURRENT=3
CHAT_TIMEOUT_SECONDS=150
# Input safety budget (conservative UTF-8 estimate); reserve model output separately.
# Never trim candidate experiences/qualifiers to meet this limit.
CONTEXT_MAX_INPUT_TOKENS=150000
ARCHIVE_POLL_SECONDS=10

# 构建时生成 data/fonts；为空可关闭优化字体，仍使用原系统字体。
# PDF_CJK_FONT_DIR=/app/data/fonts
MCP_PREVIEW_TIMEOUT_SECONDS=90
MCP_PREVIEW_QUEUE_TIMEOUT_SECONDS=300
# MCP_TEMPLATE_PREVIEW_DIR=/app/data/template_previews
