# Runtime-only environment, injected with Compose format: raw (Compose >= 2.30).
# Do not add surrounding quotes or inline comments to values.
# init_env.py replaces the next two placeholders without printing keys.
DATA_ENCRYPTION_KEYS=__GENERATED_KEYRING__
DATA_ENCRYPTION_ACTIVE_KEY=v1
ACCOUNT_SECRET=__GENERATED_ACCOUNT_SECRET__

# Fill these on the server using your provider's actual model names.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_STRUCTURED_MODEL=
LLM_VISION_MODEL=

# Public email login: use an authorized sender at your verified domain.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM=
# Alternative: EMAIL_PROVIDER=smtp and fill the following fields.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

AUTH_EMAIL_DAILY_LIMIT=90
AUTH_EMAIL_MONTHLY_LIMIT=2800
ACCOUNT_DAILY_TURN_LIMIT=80
ALLOW_GUEST_EXPERIENCE=true
GUEST_RETENTION_HOURS=24
GUEST_DAILY_TURN_LIMIT=20
MODEL_MAX_CONCURRENT=3
CHAT_TIMEOUT_SECONDS=150
ARCHIVE_POLL_SECONDS=10
SESSION_RETENTION_DAYS=0
JEV_API_KEY=
# Optional public company/job search. Empty disables search, not URL reading.
TAVILY_API_KEY=
